@model List<TaskManager.Web.Models.TaskItem>

@{
    ViewData["Title"] = "Tasks";
}

<h1>My Tasks</h1>
<table>
    <tr>
        <th>Title</th>
        <th>Due Date</th>
        <th>Completed</th>
    </tr>

    @foreach(var task in Model)
    {
        <tr>
            <td>@task.Title</td>
            <td>@task.DueDate?.ToString("MM/dd/yy")</td>
            <td>@task.IsCompleted</td>
        </tr>
    }
</table>