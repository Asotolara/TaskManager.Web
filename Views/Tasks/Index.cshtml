@model List<TaskManager.Web.Models.TaskItem>

@{
    ViewData["Title"] = "Tasks";
}

<h1>My Tasks</h1>
<a asp-action="Create">Create New Task</a>
<table>
    <tr>
        <th>Title</th>
        <th>Due Date</th>
        <th>Completed</th>
        <th>Delete</th>
        <th>Edit</th>
    </tr>

    @foreach(var task in Model)
    {
        <tr>
            
            <td>@task.Title</td>
            <td>@task.DueDate?.ToString("MM/dd/yy")</td>
            <td>@task.IsCompleted</td>
            <td><a asp-action="Delete" asp-route-id="@task.Id">Delete</a></td>
            <td><a asp-action="Edit" asp-route-id="@task.Id">Edit</a></td>
        </tr>
    }
</table>